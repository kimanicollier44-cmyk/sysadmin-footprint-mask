FROM alpine:3.20

RUN apk add --no-cache \
    bash \
    curl \
    iproute2 \
    iptables \
    openssh-client \
    git \
    coreutils

RUN adduser -D -u 1000 operator && \
    mkdir -p /home/operator/workspace && \
    chown -R operator:operator /home/operator

USER operator
WORKDIR /home/operator/workspace
ENTRYPOINT ["/bin/bash"]
